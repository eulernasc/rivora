rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/authorizedUsers/$(request.auth.uid);
    }

    function authorized() {
      return signedIn() && exists(userPath())
        && (!('active' in get(userPath()).data)
          || get(userPath()).data.active == true);
    }

    function roleIs(role) {
      return authorized() && get(userPath()).data.role == role;
    }

    // O banco verifica as telas explicitamente autorizadas pelo administrador.
    function pageAllowed(page) {
      return roleIs('admin') || (
        authorized()
        && get(userPath()).data.role in ['viewer','operator']
        && ('pages' in get(userPath()).data)
        && get(userPath()).data.pages is list
        && page in get(userPath()).data.pages
      );
    }

    function canReadOperations() {
      return pageAllowed('Visão geral') || pageAllowed('Fechamentos e Importações');
    }

    function canReadResponsibles() {
      return canReadOperations() || pageAllowed('Responsáveis');
    }

    function canOperate() {
      return roleIs('admin') || (
        roleIs('operator') && pageAllowed('Fechamentos e Importações')
      );
    }

    function validTrainingUser() {
      return request.resource.data.keys().hasOnly([
          'name','email','role','active','pages','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name','email','role','active','pages','createdAt','updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.role in ['viewer','operator']
        && request.resource.data.active is bool
        && request.resource.data.pages is list
        && request.resource.data.pages.size() >= 1
        && request.resource.data.pages.size() <= 10
        && request.resource.data.pages.hasOnly([
          'Visão geral','Relatórios','Tarefas','Automações',
          'Fechamentos e Importações','Responsáveis','Retornos',
          'Análises','CPH Frota Leve','Histórico'
        ])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validCycle(cycle) {
      return cycle.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function validFront(frontId) {
      return frontId.matches('^F(0[1-9]|1[0-3])$');
    }

    function validOperation(operationId) {
      return operationId.matches('^OP0[1-8]$');
    }

    function validClosureStatus(value) {
      return value in ['Aguardando confirmação', 'Confirmado', 'Atrasado'];
    }

    function validImportDecision(value) {
      return value in ['Pendente', 'Realiza importação', 'Não realiza importação'];
    }

    function validImportStatus(value) {
      return value in ['Não iniciada', 'Em andamento', 'Concluída', 'Não se aplica'];
    }

    function validSource(value) {
      return value in ['manual', 'migration', 'power_automate'];
    }

    function validOptionalConfirmedAt() {
      return !('confirmedAt' in request.resource.data)
        || request.resource.data.confirmedAt == null
        || request.resource.data.confirmedAt is timestamp;
    }

    function validFrontDocument() {
      return request.resource.data.keys().hasOnly([
          'closureStatus',
          'importDecision',
          'importStatus',
          'confirmedAt',
          'source',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'closureStatus',
          'importDecision',
          'importStatus',
          'source',
          'updatedAt'
        ])
        && validClosureStatus(request.resource.data.closureStatus)
        && validImportDecision(request.resource.data.importDecision)
        && validImportStatus(request.resource.data.importStatus)
        && validSource(request.resource.data.source)
        && validOptionalConfirmedAt()
        && request.resource.data.updatedAt is timestamp;
    }

    function validBridgeFrontCreate() {
      return request.resource.data.keys().hasOnly([
          'importStatus',
          'source',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'importStatus',
          'source',
          'updatedAt'
        ])
        && request.resource.data.importStatus == 'Concluída'
        && request.resource.data.source == 'power_automate'
        && request.resource.data.updatedAt is timestamp;
    }

    function validBridgeFrontUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'closureStatus',
          'importStatus',
          'confirmedAt',
          'source',
          'updatedAt'
        ])
        && request.resource.data.importStatus == 'Concluída'
        && request.resource.data.source == 'power_automate'
        && request.resource.data.updatedAt is timestamp
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'closureStatus',
            'confirmedAt'
          ])
          || (
            request.resource.data.closureStatus == 'Confirmado'
            && request.resource.data.confirmedAt is timestamp
          )
        );
    }

    function validResponsibleDocument(isCreate) {
      return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'email',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.active is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (isCreate || request.resource.data.createdAt == resource.data.createdAt);
    }

    function validAssignment() {
      return request.resource.data.keys().hasOnly([
          'responsibleId',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'responsibleId',
          'updatedAt'
        ])
        && (
          request.resource.data.responsibleId == null
          || request.resource.data.responsibleId is string
        )
        && request.resource.data.updatedAt is timestamp;
    }

    function validOperationConfirmation() {
      return request.resource.data.keys().hasOnly([
          'status',
          'expectedAt',
          'confirmedAt',
          'lastAskedAt',
          'source',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'status',
          'expectedAt',
          'confirmedAt',
          'lastAskedAt',
          'source',
          'updatedAt'
        ])
        && request.resource.data.status in ['pending', 'confirmed']
        && (
          request.resource.data.expectedAt == null
          || request.resource.data.expectedAt is timestamp
        )
        && (
          request.resource.data.confirmedAt == null
          || request.resource.data.confirmedAt is timestamp
        )
        && request.resource.data.lastAskedAt is timestamp
        && request.resource.data.source == 'power_automate'
        && request.resource.data.updatedAt is timestamp
        && (
          (
            request.resource.data.status == 'pending'
            && request.resource.data.expectedAt is timestamp
            && request.resource.data.confirmedAt == null
          )
          || (
            request.resource.data.status == 'confirmed'
            && request.resource.data.expectedAt == null
            && request.resource.data.confirmedAt is timestamp
          )
        );
    }

    match /authorizedUsers/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || roleIs('admin');
      allow list: if roleIs('admin');
      allow create: if roleIs('admin') && validTrainingUser();
      allow update: if roleIs('admin')
        && resource.data.role in ['viewer','operator']
        && validTrainingUser()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role','active','pages','updatedAt']);
      allow delete: if false;
    }

    match /responsibles/{responsibleId} {
      allow list, get: if canReadResponsibles();
      allow create: if roleIs('admin') && validResponsibleDocument(true);
      allow update: if roleIs('admin') && validResponsibleDocument(false);
      allow delete: if false;
    }

    match /operationAssignments/{operationId} {
      allow list: if canReadResponsibles();
      allow get: if canReadResponsibles() && validOperation(operationId);
      allow create, update: if roleIs('admin')
        && validOperation(operationId)
        && validAssignment();
      allow delete: if false;
    }

    match /closingCycles/{cycle}/operations/{operationId} {
      allow list: if canReadOperations() && validCycle(cycle);
      allow get: if canReadOperations() && validCycle(cycle) && validOperation(operationId);
      allow create, update: if roleIs('bridge')
        && validCycle(cycle)
        && validOperation(operationId)
        && validOperationConfirmation();
      allow delete: if false;
    }

    match /closingCycles/{cycle}/fronts/{frontId} {
      allow list: if canReadOperations() && validCycle(cycle);
      allow get: if canReadOperations() && validCycle(cycle) && validFront(frontId);

      allow create: if validCycle(cycle)
        && validFront(frontId)
        && (
          (canOperate() && validFrontDocument())
          || (roleIs('bridge') && validBridgeFrontCreate())
        );

      allow update: if validCycle(cycle)
        && validFront(frontId)
        && (
          (canOperate() && validFrontDocument())
          || (roleIs('bridge') && validBridgeFrontUpdate())
        );

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
