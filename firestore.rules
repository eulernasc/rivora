rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/authorizedUsers/$(request.auth.uid);
    }

    function authorized() {
      return signedIn() && exists(userPath());
    }

    function roleIs(role) {
      return authorized() && get(userPath()).data.role == role;
    }

    function validCycle(cycle) {
      return cycle.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function validFront(frontId) {
      return frontId.matches('^F(0[1-9]|1[0-3])$');
    }

    function validOperation(operationId) {
      return operationId.matches('^OP0[1-8]$');
    }

    // Teams bridge reads only responsible records linked to a supported operation.
    function assignedResponsible(operationId, responsibleId) {
      let assignment = /databases/$(database)/documents/operationAssignments/$(operationId);
      return exists(assignment) && get(assignment).data.responsibleId == responsibleId;
    }

    function linkedResponsible(responsibleId) {
      return assignedResponsible('OP01', responsibleId)
        || assignedResponsible('OP02', responsibleId)
        || assignedResponsible('OP03', responsibleId)
        || assignedResponsible('OP04', responsibleId)
        || assignedResponsible('OP05', responsibleId)
        || assignedResponsible('OP06', responsibleId)
        || assignedResponsible('OP07', responsibleId)
        || assignedResponsible('OP08', responsibleId);
    }

    // notifications/{operationId}: UUID, responsible document ID, delivery state,
    // askedAt and updatedAt timestamps. No email or credential is stored here.
    function validNotification() {
      let d = request.resource.data;
      return d.keys().hasOnly(['requestId', 'responsibleId', 'status', 'askedAt', 'updatedAt'])
        && d.keys().hasAll(['requestId', 'responsibleId', 'status', 'askedAt', 'updatedAt'])
        && d.requestId is string && d.requestId.size() == 36
        && d.requestId.matches('^[a-f0-9-]{36}$')
        && d.responsibleId is string && d.responsibleId.size() > 0 && d.responsibleId.size() <= 128
        && d.responsibleId.matches('^[A-Za-z0-9_-]+$')
        && d.status in ['sending', 'waiting', 'answered', 'failed']
        && d.askedAt is timestamp && d.updatedAt is timestamp
        && d.updatedAt >= request.time - duration.value(5, 'm')
        && d.updatedAt <= request.time + duration.value(1, 'm');
    }

    function validNotificationTransition() {
      let d = request.resource.data;
      let old = resource.data;
      return (old.status == 'answered' && d.status == 'sending' && d.requestId != old.requestId)
        || (d.requestId == old.requestId && d.responsibleId == old.responsibleId
          && d.askedAt == old.askedAt
          && ((old.status == 'sending' && d.status in ['waiting', 'answered', 'failed'])
            || (old.status == 'waiting' && d.status == 'answered')));
    }

    function validClosureStatus(value) {
      return value in ['Aguardando confirmação', 'Confirmado', 'Atrasado'];
    }

    function validImportDecision(value) {
      return value in ['Pendente', 'Realiza importação', 'Não realiza importação'];
    }

    function validImportStatus(value) {
      return value in ['Não iniciada', 'Em andamento', 'Concluída', 'Não se aplica'];
    }

    function validSource(value) {
      return value in ['manual', 'migration', 'power_automate'];
    }

    function validOptionalConfirmedAt() {
      return !('confirmedAt' in request.resource.data)
        || request.resource.data.confirmedAt == null
        || request.resource.data.confirmedAt is timestamp;
    }

    function validFrontDocument() {
      return request.resource.data.keys().hasOnly([
          'closureStatus',
          'importDecision',
          'importStatus',
          'confirmedAt',
          'source',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'closureStatus',
          'importDecision',
          'importStatus',
          'source',
          'updatedAt'
        ])
        && validClosureStatus(request.resource.data.closureStatus)
        && validImportDecision(request.resource.data.importDecision)
        && validImportStatus(request.resource.data.importStatus)
        && validSource(request.resource.data.source)
        && validOptionalConfirmedAt()
        && request.resource.data.updatedAt is timestamp;
    }

    function validBridgeFrontCreate() {
      return request.resource.data.keys().hasOnly([
          'importStatus',
          'source',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'importStatus',
          'source',
          'updatedAt'
        ])
        && request.resource.data.importStatus == 'Concluída'
        && request.resource.data.source == 'power_automate'
        && request.resource.data.updatedAt is timestamp;
    }

    function validBridgeFrontUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'importStatus',
          'source',
          'updatedAt'
        ])
        && request.resource.data.importStatus == 'Concluída'
        && request.resource.data.source == 'power_automate'
        && request.resource.data.updatedAt is timestamp;
    }

    function validResponsibleDocument(isCreate) {
      return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'email',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.active is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (isCreate || request.resource.data.createdAt == resource.data.createdAt);
    }

    function validAssignment() {
      return request.resource.data.keys().hasOnly([
          'responsibleId',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'responsibleId',
          'updatedAt'
        ])
        && (
          request.resource.data.responsibleId == null
          || request.resource.data.responsibleId is string
        )
        && request.resource.data.updatedAt is timestamp;
    }

    function validOperationConfirmation() {
      return request.resource.data.keys().hasOnly([
          'status',
          'expectedAt',
          'confirmedAt',
          'lastAskedAt',
          'source',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'status',
          'expectedAt',
          'confirmedAt',
          'lastAskedAt',
          'source',
          'updatedAt'
        ])
        && request.resource.data.status in ['pending', 'confirmed']
        && (
          request.resource.data.expectedAt == null
          || request.resource.data.expectedAt is timestamp
        )
        && (
          request.resource.data.confirmedAt == null
          || request.resource.data.confirmedAt is timestamp
        )
        && request.resource.data.lastAskedAt is timestamp
        && request.resource.data.source == 'power_automate'
        && request.resource.data.updatedAt is timestamp
        && (
          (
            request.resource.data.status == 'pending'
            && request.resource.data.expectedAt is timestamp
            && request.resource.data.confirmedAt == null
          )
          || (
            request.resource.data.status == 'confirmed'
            && request.resource.data.expectedAt == null
            && request.resource.data.confirmedAt is timestamp
          )
        );
    }

    match /authorizedUsers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /responsibles/{responsibleId} {
      allow list: if roleIs('admin');
      allow get: if roleIs('admin') || (roleIs('bridge') && linkedResponsible(responsibleId));
      allow create: if roleIs('admin') && validResponsibleDocument(true);
      allow update: if roleIs('admin') && validResponsibleDocument(false);
      allow delete: if false;
    }

    match /operationAssignments/{operationId} {
      allow list: if roleIs('admin');
      allow get: if (roleIs('admin') || roleIs('bridge')) && validOperation(operationId);
      allow create, update: if roleIs('admin')
        && validOperation(operationId)
        && validAssignment();
      allow delete: if false;
    }

    match /closingCycles/{cycle}/operations/{operationId} {
      allow list: if roleIs('admin') && validCycle(cycle);
      allow get: if (roleIs('admin') || roleIs('bridge')) && validCycle(cycle) && validOperation(operationId);
      allow create, update: if roleIs('bridge')
        && validCycle(cycle)
        && validOperation(operationId)
        && validOperationConfirmation();
      allow delete: if false;
    }

    match /closingCycles/{cycle}/fronts/{frontId} {
      allow list: if roleIs('admin') && validCycle(cycle);
      allow get: if (roleIs('admin') || roleIs('bridge')) && validCycle(cycle) && validFront(frontId);

      allow create: if validCycle(cycle)
        && validFront(frontId)
        && (
          (roleIs('admin') && validFrontDocument())
          || (roleIs('bridge') && validBridgeFrontCreate())
        );

      allow update: if validCycle(cycle)
        && validFront(frontId)
        && (
          (roleIs('admin') && validFrontDocument())
          || (roleIs('bridge') && validBridgeFrontUpdate())
        );

      allow delete: if false;
    }

    match /closingCycles/{cycle}/notifications/{operationId} {
      allow get: if (roleIs('admin') || roleIs('bridge')) && validCycle(cycle) && validOperation(operationId);
      allow list: if roleIs('admin') && validCycle(cycle);
      allow create: if roleIs('bridge') && validCycle(cycle) && validOperation(operationId)
        && validNotification() && request.resource.data.status == 'sending';
      allow update: if roleIs('bridge') && validCycle(cycle) && validOperation(operationId)
        && validNotification() && validNotificationTransition();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
